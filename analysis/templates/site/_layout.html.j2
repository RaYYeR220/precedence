<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Precedence{% endblock %}</title>
<meta name="description" content="How Solana leaders ordered our probe transactions: rules, strictness and every block they landed in.">
<meta name="color-scheme" content="light dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&display=swap">
<link rel="stylesheet" href="assets/app.css?v={{ v['assets/app.css'] }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%230B1016'/%3E%3Cg fill='%23E9B867'%3E%3Crect x='3' y='4' width='1.6' height='8'/%3E%3Crect x='6' y='5' width='1.6' height='7'/%3E%3Crect x='9' y='6.5' width='1.6' height='5.5'/%3E%3Crect x='12' y='8' width='1.6' height='4'/%3E%3C/g%3E%3C/svg%3E">
</head>
<body class="{% block body_class %}{% endblock %}">
<a class="skip" href="#main">Skip to content</a>
<header class="bar">
  <div class="wrap bar-inner">
    <a class="mark" href="index.html" aria-label="Precedence, overview">
      <svg class="mark-glyph" viewBox="0 0 20 16" aria-hidden="true"><rect x="1" y="2" width="2" height="12"/><rect x="5" y="4" width="2" height="10"/><rect x="9" y="6" width="2" height="8"/><rect x="13" y="8" width="2" height="6"/><rect x="17" y="10" width="2" height="4"/></svg>
      <span>Precedence</span>
    </a>
    <nav class="nav" aria-label="Pages">
      <a href="index.html"{% if page == 'overview' %} aria-current="page"{% endif %}>Overview</a>
      <a href="blocks.html"{% if page == 'blocks' %} aria-current="page"{% endif %}>Blocks</a>
    </nav>
    <p class="bar-meta">{{ runs|length }} run{{ '' if runs|length == 1 else 's' }}{% if meta.analysis_version %}, analysis {{ meta.analysis_version }}{% endif %}</p>
  </div>
</header>
<main id="main" class="wrap">
{% block main %}{% endblock %}
</main>
<footer class="wrap foot">
  <p>Every number on these pages is generated by <code>python -m prec_analysis render</code> from <code>results/*.json</code> and the raw files under <code>data/</code>. Runs:
  {% for r in runs %}<code class="num">{{ r.run_id }}</code>{% if r.mode != 'live' %} ({{ r.mode }}){% endif %}{{ ', ' if not loop.last else '.' }}{% else %}none yet.{% endfor %}</p>
</footer>
<div class="tip" id="tip" role="status" aria-live="polite" hidden></div>
{% block scripts %}{% endblock %}
</body>
</html>
