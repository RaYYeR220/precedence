# Copy to .env. Every value has a safe default; nothing here is secret except
# the gRPC token, and the keypair is never configured here (mount keys/burner.json).

# Live sending needs this exact value AND the --live flag AND a mounted keypair.
# PRECEDENCE_LIVE=i-accept-spending-sol

# Spend cap in lamports (default 50_000_000 = 0.05 SOL, hard maximum 0.06 SOL).
# PRECEDENCE_CAP_LAMPORTS=50000000

# RPC used for snapshots, blockhashes, statuses, getBlock and verification.
# PRECEDENCE_RPC=https://api.mainnet-beta.solana.com
# PRECEDENCE_WS=wss://api.mainnet-beta.solana.com
# PRECEDENCE_POLL_RPC=https://api.mainnet-beta.solana.com

# Optional Yellowstone gRPC endpoint for entry boundaries and block footers.
# PRECEDENCE_GRPC=https://solana-yellowstone-grpc.publicnode.com:443
# PRECEDENCE_GRPC_TOKEN=

# Fix the run seed to replay a design exactly.
# PRECEDENCE_SEED=

# Length of the dry run in `docker compose up` (slots, ~213 ms each).
# DRYRUN_HORIZON_SLOTS=900
